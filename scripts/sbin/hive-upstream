#!/bin/bash
set -euo pipefail

FILE=/etc/nginx/hive-upstream.conf

case "${1:-}" in
    blue)  PORT=3000 ;;
    green) PORT=3001 ;;
    *)     echo "usage: hive-upstream blue|green" >&2; exit 2 ;;
esac

BACKUP=$(mktemp)
HAD_FILE=0
if [ -f "$FILE" ]; then
    cp "$FILE" "$BACKUP"
    HAD_FILE=1
fi

restore() {
    if [ "$HAD_FILE" -eq 1 ]; then cp "$BACKUP" "$FILE"; else rm -f "$FILE"; fi
}
# Interrupted after the reload, nginx already serves the new slot: reload the restored file too.
trap 'restore; { /usr/sbin/nginx -t -q && /usr/sbin/nginx -s reload; } || true; rm -f "$BACKUP"; exit 130' INT TERM HUP

echo "server 127.0.0.1:$PORT;" > "$FILE.new"
mv "$FILE.new" "$FILE"

if ! /usr/sbin/nginx -t -q || ! /usr/sbin/nginx -s reload; then
    restore
    rm -f "$BACKUP"
    echo "hive-upstream: nginx rejected the switch to $1; previous upstream restored" >&2
    exit 1
fi
rm -f "$BACKUP"
