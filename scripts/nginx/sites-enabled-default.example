upstream hive_active {
    include /etc/nginx/hive-upstream.conf;
}

server {
    listen 127.0.0.1:3999;
    server_name _;

    location / {
        proxy_pass http://hive_active;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;
    server_name _;
    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;
    server_name hive.leex.dev; # managed by Certbot
    location / {
        try_files $uri $uri/ =404;
    }
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/hive.leex.dev/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/hive.leex.dev/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = hive.leex.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot
    listen 80;
    listen [::]:80;
    server_name hive.leex.dev;
    return 404; # managed by Certbot
}

server {
    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;
    server_name hivegame.com; # managed by Certbot

    location = /health/ready {
        deny all;
    }

    location /pkg/ {
        root /home/drone/hive/bin;
        try_files /blue/site$uri /green/site$uri @app;
        gzip_static on;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location @app {
        proxy_pass http://hive_active;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://hive_active;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /download/rules.pdf {
        alias /var/www/html/rules.pdf;
        add_header Content-Type "application/pdf";
        add_header Content-Disposition "inline; filename=\"rules.pdf\"";
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/hivegame.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/hivegame.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    listen [::]:443 ssl;
    listen 443 ssl;
    server_name www.hivegame.com;
    ssl_certificate /etc/letsencrypt/live/hivegame.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hivegame.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    return 301 https://hivegame.com$request_uri;
}

server {
    if ($host = www.hivegame.com) {
        return 301 https://hivegame.com$request_uri;
    }
    if ($host = hivegame.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot
    listen 80;
    listen [::]:80;
    server_name hivegame.com www.hivegame.com;
    return 404; # managed by Certbot
}
